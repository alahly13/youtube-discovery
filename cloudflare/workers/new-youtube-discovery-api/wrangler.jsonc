{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-youtube-discovery-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "NEW_BUCKET",
      "bucket_name": "new-youtube-discovery-private"
    }
  ]
}
