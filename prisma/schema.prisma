// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// Canonical 18 Database Models — Phase 1.4 Approved Foundation
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  admin
  user
}

enum GenerationState {
  PREPARING
  UPLOADING
  VERIFYING
  COMMITTED
  FAILED
  ABANDONED
}

enum TempObjectStatus {
  ACTIVE
  EXPIRED
  DELETING
  DELETED
  FAILED
}

enum SyncBatchState {
  PENDING
  PREPARING
  UPLOADING
  VERIFYING
  COMMITTED
  CONFLICT
  FAILED
}

enum QueueItemStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum SavedEntityType {
  VIDEO
  CHANNEL
  PLAYLIST
}

enum PlaylistEntryEntityType {
  VIDEO
  CHANNEL
  PLAYLIST
  CUSTOM
}

// ───────────────────────────────────────────────────────────────────────────
// 1. Identity & Profiles
// ───────────────────────────────────────────────────────────────────────────

model UserProfile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id     String?   @unique @db.Uuid
  storage_owner_uuid String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storage_namespace String   @unique @db.VarChar(64)
  username         String    @unique @db.VarChar(64)
  role             UserRole  @default(admin)
  is_suspended     Boolean   @default(false)
  is_deleted       Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  // Relations
  preferences          UserPreference?
  managed_api_keys     ManagedApiKey[]
  storage_datasets     StorageDataset[]
  storage_generations  StorageGeneration[]
  storage_manifest_parts StorageManifestPart[]
  storage_temp_objects StorageTempObject[]
  saved_items          SavedItemIndex[]
  playlists            UserPlaylist[]
  playlist_groups      UserPlaylistGroup[]
  playlist_entries     UserPlaylistEntry[]
  research_queue       ResearchQueueItem[]
  saved_references     SavedReference[]
  saved_search_presets SavedSearchPreset[]
  search_history       SearchHistoryRecord[]
  quota_usage_events   QuotaUsageEvent[]
  save_sync_batches    SaveSyncBatch[]
  archived_manifests   ArchivedManifest[]
  acted_audit_logs     AuditLog[]           @relation("AuditActor")
  subject_audit_logs   AuditLog[]           @relation("AuditSubject")

  @@map("user_profiles")
}

model UserPreference {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                String      @unique @db.Uuid
  preferred_timezone      String      @default("America/Los_Angeles") @db.VarChar(64)
  theme                   String      @default("system") @db.VarChar(16)
  default_page_size       Int         @default(25)
  default_max_pages       Int         @default(3)
  default_max_items       Int         @default(150)
  auto_save_enabled       Boolean     @default(true)
  auto_save_interval_hours Int        @default(12)
  created_at              DateTime    @default(now()) @db.Timestamptz(6)
  updated_at              DateTime    @updatedAt @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ManagedApiKey {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                String      @db.Uuid
  key_nickname            String      @db.VarChar(64)
  encrypted_key_bundle    Json
  key_fingerprint         String      @db.VarChar(64)
  google_cloud_project_id String?     @db.VarChar(64)
  associated_account_email String?    @db.VarChar(255)
  is_active               Boolean     @default(true)
  daily_quota_limit       Int         @default(10000)
  created_at              DateTime    @default(now()) @db.Timestamptz(6)
  updated_at              DateTime    @updatedAt @db.Timestamptz(6)
  revoked_at              DateTime?   @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  quota_events QuotaUsageEvent[]

  @@unique([owner_id, id])
  @@unique([owner_id, key_fingerprint])
  @@index([owner_id, is_active])
  @@map("managed_api_keys")
}

// ───────────────────────────────────────────────────────────────────────────
// 2. Storage Registry & Generational Lifecycle
// ───────────────────────────────────────────────────────────────────────────

model StorageDataset {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id              String      @db.Uuid
  dataset_type          String      @db.VarChar(32)
  entity_id             String?     @db.VarChar(128)
  display_name          String      @db.VarChar(255)
  current_revision      BigInt      @default(0)
  current_generation_id String?     @db.Uuid
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @updatedAt @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  generations StorageGeneration[]
  save_sync_batches SaveSyncBatch[]

  @@unique([owner_id, id])
  @@unique([owner_id, dataset_type])
  @@index([owner_id, dataset_type])
  @@map("storage_datasets")
}

model StorageGeneration {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id             String          @db.Uuid
  dataset_id           String          @db.Uuid
  parent_generation_id String?         @db.Uuid
  source_batch_id      String?         @db.Uuid
  generation_number    Int
  state                GenerationState @default(PREPARING)
  total_parts          Int             @default(0)
  total_records        Int             @default(0)
  total_bytes          BigInt          @default(0)
  aggregate_sha256     String?         @db.Char(64)
  origin_device_id     String?         @db.VarChar(128)
  origin_device_label  String?         @db.VarChar(128)
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  committed_at         DateTime?       @db.Timestamptz(6)

  owner   UserProfile    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  dataset StorageDataset @relation(fields: [owner_id, dataset_id], references: [owner_id, id], onDelete: Cascade)
  parent  StorageGeneration? @relation("GenerationLineage", fields: [owner_id, dataset_id, parent_generation_id], references: [owner_id, dataset_id, id], onDelete: Restrict)
  children StorageGeneration[] @relation("GenerationLineage")
  source_batch SaveSyncBatch? @relation(fields: [owner_id, dataset_id, source_batch_id], references: [owner_id, dataset_id, id], onDelete: Restrict)
  parts   StorageManifestPart[]

  @@unique([owner_id, dataset_id, id])
  @@unique([owner_id, dataset_id, generation_number])
  @@index([owner_id, dataset_id, state])
  @@map("storage_generations")
}

model StorageManifestPart {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id      String      @db.Uuid
  dataset_id    String      @db.Uuid
  generation_id String      @db.Uuid
  part_number   Int
  storage_path  String      @db.VarChar(512)
  bucket_id     String      @default("new-youtube-discovery-private") @db.VarChar(64)
  byte_count    BigInt
  record_count  Int
  sha256        String      @db.Char(64)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)

  owner      UserProfile       @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  generation StorageGeneration @relation(fields: [owner_id, dataset_id, generation_id], references: [owner_id, dataset_id, id], onDelete: Cascade)

  @@unique([owner_id, dataset_id, generation_id, id])
  @@unique([generation_id, part_number])
  @@index([owner_id, storage_path])
  @@map("storage_manifest_parts")
}

model StorageTempObject {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String           @db.Uuid
  storage_path String           @db.VarChar(512)
  bucket_id    String           @default("new-youtube-discovery-private") @db.VarChar(64)
  byte_count   BigInt
  sha256       String           @db.Char(64)
  purpose      String           @db.VarChar(64)
  status       TempObjectStatus @default(ACTIVE)
  expires_at   DateTime         @db.Timestamptz(6)
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?        @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id, status, expires_at])
  @@map("storage_temp_objects")
}

// ───────────────────────────────────────────────────────────────────────────
// 3. User Research Libraries & Index Pointers
// ───────────────────────────────────────────────────────────────────────────

model SavedItemIndex {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id          String          @db.Uuid
  entity_type       SavedEntityType
  platform_item_id  String          @db.VarChar(64)
  title             String          @db.VarChar(512)
  channel_title     String?         @db.VarChar(255)
  thumbnail_url     String?         @db.VarChar(512)
  is_shorts_like    Boolean         @default(false)
  is_age_restricted Boolean         @default(false)
  published_at      DateTime?       @db.Timestamptz(6)
  views_count       BigInt?
  likes_count       BigInt?
  comments_count    BigInt?
  duration_seconds  Int?
  saved_at          DateTime        @default(now()) @db.Timestamptz(6)
  saved_date        String          @db.VarChar(10)
  origin_device_id  String?         @db.VarChar(128)
  origin_device_label String?       @db.VarChar(128)
  dataset_id        String?         @db.Uuid
  generation_id     String?         @db.Uuid
  manifest_part_id  String?         @db.Uuid
  item_position     Int?
  /**
   * Canonical resource discriminator. `entity_type` is a coarse relational
   * bucket (VIDEO/CHANNEL/PLAYLIST); `resource_type` preserves the exact
   * taxonomy value (VIDEO_SHORT, YOUTUBE_PLAYLIST, ...). Never infer this from
   * duration or title.
   */
  resource_type     String?         @db.VarChar(32)
  resource_id       String?         @db.VarChar(128)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, entity_type, platform_item_id])
  @@index([owner_id, saved_date])
  @@index([owner_id, origin_device_id])
  @@index([owner_id, entity_type])
  @@index([owner_id, resource_type])
  @@index([owner_id, published_at])
  @@map("saved_items_index")
}

model UserPlaylist {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id          String      @db.Uuid
  title             String      @db.VarChar(255)
  description       String?
  display_order     Int         @default(0)
  total_items_count Int         @default(0)
  thumbnail_urls    Json        @default("[]")
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @updatedAt @db.Timestamptz(6)

  owner   UserProfile         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  groups  UserPlaylistGroup[]
  entries UserPlaylistEntry[]

  @@unique([owner_id, id])
  @@index([owner_id, display_order])
  @@map("user_playlists")
}

model UserPlaylistGroup {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String      @db.Uuid
  playlist_id  String      @db.Uuid
  title        String      @db.VarChar(255)
  notes        String?
  position     Int         @default(0)
  is_collapsed Boolean     @default(false)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @updatedAt @db.Timestamptz(6)

  owner    UserProfile       @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  playlist UserPlaylist      @relation(fields: [owner_id, playlist_id], references: [owner_id, id], onDelete: Cascade)
  entries  UserPlaylistEntry[]

  @@unique([playlist_id, id])
  @@index([owner_id, playlist_id, position])
  @@map("user_playlist_groups")
}

model UserPlaylistEntry {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id         String                  @db.Uuid
  playlist_id      String                  @db.Uuid
  group_id         String?                 @db.Uuid
  entity_type      PlaylistEntryEntityType
  platform_item_id String?                 @db.VarChar(64)
  custom_title     String?                 @db.VarChar(512)
  custom_url       String?                 @db.VarChar(1024)
  notes            String?
  position         Int                     @default(0)
  added_at         DateTime                @default(now()) @db.Timestamptz(6)

  owner    UserProfile        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  playlist UserPlaylist       @relation(fields: [owner_id, playlist_id], references: [owner_id, id], onDelete: Cascade)
  group    UserPlaylistGroup? @relation(fields: [playlist_id, group_id], references: [playlist_id, id], onDelete: SetNull)

  @@index([owner_id, playlist_id, position])
  @@index([owner_id, playlist_id, group_id])
  @@map("user_playlist_entries")
}

model ResearchQueueItem {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id         String          @db.Uuid
  query_text       String          @db.VarChar(512)
  source_origin    String          @db.VarChar(64)
  source_entity_id String?         @db.VarChar(64)
  status           QueueItemStatus @default(PENDING)
  priority         Int             @default(0)
  dataset_id       String?         @db.Uuid
  generation_id    String?         @db.Uuid
  manifest_part_id String?         @db.Uuid
  item_position    Int?
  queued_at        DateTime        @default(now()) @db.Timestamptz(6)
  reviewed_at      DateTime?       @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id, status, queued_at])
  @@index([owner_id, priority])
  @@map("research_queue_items")
}

model SavedReference {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id         String      @db.Uuid
  title            String      @db.VarChar(512)
  /**
   * Nullable because a SAVED_TITLE is a legitimate title-only reference.
   * SAVED_LINK rows must still provide a URL; the API validates that.
   */
  url              String?     @db.VarChar(2048)
  notes            String?
  dataset_id       String?     @db.Uuid
  generation_id    String?     @db.Uuid
  manifest_part_id String?     @db.Uuid
  item_position    Int?
  record_id        String?     @db.VarChar(256)
  resource_type    String?     @db.VarChar(32)
  resource_id      String?     @db.VarChar(256)
  origin_device_id String?     @db.VarChar(128)
  origin_device_label String?  @db.VarChar(128)
  saved_at         DateTime    @default(now()) @db.Timestamptz(6)
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @updatedAt @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, record_id])
  @@index([owner_id, created_at])
  @@index([owner_id, resource_type])
  @@index([owner_id, dataset_id])
  @@map("saved_references")
}

model SavedSearchPreset {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id        String      @db.Uuid
  title           String      @db.VarChar(255)
  query_text      String      @db.VarChar(512)
  search_settings Json
  filter_snapshot Json?
  is_pinned       Boolean     @default(false)
  tags            String[]    @default([])
  record_id       String?     @db.VarChar(256)
  resource_type   String?     @db.VarChar(32)
  resource_id     String?     @db.VarChar(256)
  origin_device_id String?    @db.VarChar(128)
  origin_device_label String? @db.VarChar(128)
  saved_at        DateTime    @default(now()) @db.Timestamptz(6)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @updatedAt @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, record_id])
  @@index([owner_id, is_pinned, created_at])
  @@index([owner_id, resource_type])
  @@map("saved_search_presets")
}

model SearchHistoryRecord {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id             String      @db.Uuid
  query_text           String      @db.VarChar(512)
  search_settings      Json
  result_count         Int         @default(0)
  quota_units_consumed Int         @default(100)
  manifest_id          String      @db.VarChar(64)
  generation_id        String?     @db.Uuid
  executed_at          DateTime    @default(now()) @db.Timestamptz(6)

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id, executed_at])
  @@map("search_history_records")
}

// ───────────────────────────────────────────────────────────────────────────
// 4. Quota Accounting & Audit Log
// ───────────────────────────────────────────────────────────────────────────

model QuotaUsageEvent {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                String      @db.Uuid
  managed_api_key_id      String?     @db.Uuid
  google_cloud_project_id String      @db.VarChar(64)
  endpoint_name           String      @db.VarChar(64)
  operation_category      String      @db.VarChar(32)
  quota_units             Int
  http_status             Int
  request_sha256          String      @db.Char(64)
  occurred_at             DateTime    @default(now()) @db.Timestamptz(6)

  owner UserProfile    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  key   ManagedApiKey? @relation(fields: [owner_id, managed_api_key_id], references: [owner_id, id], onDelete: SetNull)

  @@index([owner_id, google_cloud_project_id, occurred_at])
  @@index([owner_id, managed_api_key_id, occurred_at])
  @@map("quota_usage_events")
}

model SaveSyncBatch {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id           String         @db.Uuid
  dataset_id         String         @db.Uuid
  idempotency_key    String         @db.VarChar(128)
  request_sha256     String         @db.Char(64)
  expected_revision  BigInt
  committed_revision BigInt?
  origin_device_id   String?        @db.VarChar(128)
  origin_device_label String?       @db.VarChar(128)
  state              SyncBatchState @default(PENDING)
  error_message      String?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  completed_at       DateTime?      @db.Timestamptz(6)

  owner   UserProfile    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  dataset StorageDataset @relation(fields: [owner_id, dataset_id], references: [owner_id, id], onDelete: Restrict)
  generations StorageGeneration[]

  @@unique([owner_id, dataset_id, id])
  @@unique([owner_id, dataset_id, idempotency_key])
  @@index([owner_id, dataset_id, state])
  @@map("save_sync_batches")
}

model AuditLog {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_profile_id String?      @db.Uuid
  subject_owner_id String?      @db.Uuid
  action           String       @db.VarChar(64)
  entity_type      String       @db.VarChar(64)
  entity_id        String?      @db.VarChar(128)
  details          Json?
  ip_address       String?      @db.VarChar(45)
  user_agent       String?      @db.VarChar(512)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)

  actor   UserProfile? @relation("AuditActor", fields: [actor_profile_id], references: [id], onDelete: SetNull)
  subject UserProfile? @relation("AuditSubject", fields: [subject_owner_id], references: [id], onDelete: SetNull)

  @@index([actor_profile_id, created_at])
  @@index([subject_owner_id, created_at])
  @@index([action, created_at])
  @@map("audit_logs")
}

// ───────────────────────────────────────────────────────────────────────────
// 5. Historical Archive Extension — Phase 1.5 OLD Manifest System
// ───────────────────────────────────────────────────────────────────────────

model ArchivedManifest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id            String    @db.Uuid
  manifest_id         String    @db.VarChar(128)
  category            String    @db.VarChar(64)
  source_format       String    @db.VarChar(32)
  storage_path        String    @db.VarChar(512)
  bucket_id           String    @default("old-youtube-discovery-private") @db.VarChar(64)
  original_filename   String?   @db.VarChar(255)
  mime_type           String?   @db.VarChar(128)
  status              String    @default("COMMITTED") @db.VarChar(32)
  byte_count          BigInt
  record_count        Int
  content_sha256      String    @db.Char(64)
  source_created_at   DateTime? @db.Timestamptz(6)
  source_exported_at  DateTime? @db.Timestamptz(6)
  imported_at         DateTime  @default(now()) @db.Timestamptz(6)
  provenance_metadata Json?
  filter_summary      Json?

  owner UserProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, content_sha256])
  @@unique([owner_id, manifest_id])
  @@index([owner_id, category, imported_at])
  @@map("archived_manifests")
}
