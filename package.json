{
  "name": "youtube-discovery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "env:validate": "node scripts/app-validate-env.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrations": "node scripts/db-migrations/cli.mjs",
    "db:migrations:local": "node scripts/db-migrations/cli.mjs --mode=local",
    "db:migrations:check": "node scripts/db-migrations/cli.mjs --mode=check",
    "db:migrations:json": "node scripts/db-migrations/cli.mjs --mode=json",
    "db:backup": "node scripts/backup-cli.mjs",
    "recovery:local": "node scripts/recovery/local-filesystem-scanner.mjs",
    "typecheck": "npm run db:generate && tsc --noEmit --incremental false",
    "build": "npm run env:validate && npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:search": "node scripts/run-search-tests.mjs",
    "test:migrations": "node scripts/db-migrations/test-migrations-cli.mjs",
    "test:security": "node scripts/test-phase1-5-database-security.mjs",
    "test:old": "node scripts/test-phase1-5-old-archive.mjs",
    "test:features": "node scripts/test-phase-a-g-features.mjs",
    "test:pipeline": "node scripts/test-complete-storage-pipeline.mjs",
    "test:canonical-sync": "npx tsx scripts/test-cloud-hydration-and-canonical-sync.mjs",
    "test:recovery": "node scripts/test-phase1-6-recovery-and-download.mjs",
    "test:auth": "node scripts/test-supabase-auth.mjs",
    "auth:admin-reset": "node scripts/auth-admin-reset.mjs",
    "auth:diagnose": "node scripts/auth-diagnose.mjs",
    "test:r2": "node scripts/test-cloudflare-r2-workers.mjs",
    "worker:new:deploy": "wrangler deploy --config cloudflare/workers/new-youtube-discovery-api/wrangler.jsonc",
    "worker:old:deploy": "wrangler deploy --config cloudflare/workers/old-youtube-discovery-api/wrangler.jsonc",
    "worker:new:tail": "wrangler tail new-youtube-discovery-api",
    "worker:old:tail": "wrangler tail old-youtube-discovery-api",
    "verify": "npm run lint && npm run typecheck && npm run test:security && npm run test:old && npm run test:recovery && npm run test:auth && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "@next/env": "^16.2.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.100.9",
    "dotenv": "^18.0.8",
    "flexsearch": "^0.8.212",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.4.2",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "@google/genai@2.0.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
