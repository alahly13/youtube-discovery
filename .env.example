# Public, browser-safe application metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional public Supabase client settings. Only use these if client-side Supabase auth is added.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only database connection for Supabase PostgreSQL / Prisma.
# Keep real values in root .env.local locally or Vercel Project Settings in production.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# Server-only YouTube Data API v3 settings. Missing YOUTUBE_API_KEY disables live provider calls.
YOUTUBE_API_BASE_URL="https://www.googleapis.com/youtube/v3"
YOUTUBE_API_KEY=""
YOUTUBE_DEFAULT_REGION="US"
YOUTUBE_DEFAULT_RELEVANCE_LANGUAGE="en"
YOUTUBE_SEARCH_PAGE_SIZE="25"
YOUTUBE_SEARCH_MAX_PAGES="3"
YOUTUBE_SEARCH_MAX_ITEMS="150"
YOUTUBE_SEARCH_DELAY_MS="250"
YOUTUBE_SEARCH_CONCURRENCY="1"
YOUTUBE_DAILY_QUOTA_BUDGET="10000"
ENABLE_YOUTUBE_MANIFEST_PERSISTENCE="false"

# Server-only Gemini settings. Missing GEMINI_API_KEY disables AI route execution gracefully.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_MANIFEST_MAX_ITEMS="60"
AI_MANIFEST_MAX_CHARS="30000"

# Search storage retention period in hours (legacy disk cache only).
# Blob-backed saved history is permanent and ignores this value.
# Default: 168 hours (7 days / 1 week)
SEARCH_STORAGE_TTL_HOURS="168"

# ── Private Vercel Blob Store (authoritative persistence) ──────────────
# Playlists, saved search history, and encrypted API key settings live in
# the private Blob store and survive redeploys. Configure the SAME values
# locally (.env.local) and in Vercel Project Settings. Never prefix these
# with NEXT_PUBLIC_. Never commit real values to Git.
#
# BLOB_STORE_ID: the expected store identifier. Used for configuration
#   validation and store-identity verification (Blob URL host comparison).
#   Pass it explicitly only where the SDK supports it; otherwise the SDK's
#   documented token/OIDC resolution selects the store.
# BLOB_READ_WRITE_TOKEN: private token used through the @vercel/blob SDK
#   for reads, lists, versioned writes, and authorized deletes. NEVER expose
#   it to the browser, logs, or API responses. The app never falls back to
#   local-only storage when it is missing — routes return clear errors.
# BLOB_WEBHOOK_PUBLIC_KEY: verifies signed Vercel Blob WEBHOOK requests
#   ONLY. This application has no webhook endpoint, so this variable is NOT
#   required for reads, writes, or authentication. Set it only if a webhook
#   consumer is introduced (it must then verify signatures and reject
#   unverified payloads). Never use it as a token, password, or session key.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# ── Single administrator account (bootstrap only) ──────────────────────
# On first run the server creates exactly ONE admin account from these
# values and stores only a password hash in Blob. Afterwards the persisted
# account is authoritative: changing these vars does NOT reset credentials.
# There is no default password: ADMIN_INITIAL_PASSWORD must be set to a
# strong value (≥12 chars) before first initialization.
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""
# High-entropy session secret, independent from the Blob token and the
# API key encryption key. Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=""
# Session lifetime in seconds. Default 604800 (7 days). Applies to newly
# issued sessions; lowering it also shortens existing sessions at validation.
ADMIN_SESSION_TTL_SECONDS="604800"

# ── Managed YouTube API key encryption (AES-256-GCM) ───────────────────
# 32-byte key as base64 (44 chars), hex (64 chars), or 32 raw characters.
# Independent from Blob/session secrets. BACK THIS UP SECURELY: losing or
# changing it makes previously encrypted keys permanently unrecoverable.
# Without it, the app REFUSES to save managed keys (no plaintext fallback).
API_KEYS_ENCRYPTION_KEY=""

