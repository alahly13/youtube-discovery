# ═══════════════════════════════════════════════════════════════════════════════
# YouTube Discovery (2026) — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development.
# On Vercel, configure these variables in Project Settings > Environment Variables.
#
# Rules:
# 1. Variables prefixed with NEXT_PUBLIC_ are bundled into client code (public).
# 2. All other variables are server-only and NEVER exposed to the browser.
# 3. Supabase Auth is the SOLE authority for administrator authentication.
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. Application Metadata (Public) ──────────────────────────────────────────
# Base URL of the application. Used for metadata and redirects.
# On Vercel, VERCEL_URL is auto-detected as fallback if omitted.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 2. Supabase Auth & SSR Session (Sole Authority for Authentication) ────────
# Supabase project URL and browser-safe publishable (anon) key:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-ANON-OR-PUBLISHABLE-KEY]"

# Server-only Supabase Service Role / Secret Key for administrative operations
# (user verification, admin password recovery script, storage bucket policies).
# NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_SECRET_KEY=""

# ── 3. Administrator Identity & Session Configuration ─────────────────────────
# The administrator logs in using their Username ("asdy") and their actual Supabase Auth password.
# The server maps this username to the canonical synthetic authentication email.
# No email inbox, verification code, OTP, or magic link is required.
ADMIN_DEFAULT_USERNAME="asdy"
ADMIN_EMAIL="asdy@youtube.discov.com"

# Session lifetime in seconds. Default: 604800 (7 days / 1 week).
# Controls @supabase/ssr cookie lifetime and server-side verification.
# Accepts integer seconds (e.g. 604800) or human units (e.g. "7d", "1w", "24h").
SESSION_TTL_SECONDS="604800"

# ── 4. Supabase PostgreSQL Database (Prisma 7 / PostgreSQL 17) ────────────────
# Pooled connection string (port 6543 via Supavisor pooler) for Prisma Client runtime:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432 direct to database) for Prisma CLI migrations & backups:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── 5. Cloudflare R2 via Dedicated Workers (Authoritative Object Storage) ─────
# Dedicated Cloudflare Workers mediating all manifest and archive storage in Cloudflare R2.
# Authenticated via HMAC-SHA256 capability tokens (zero AWS SDKs or raw cloud credentials).
R2_NEW_WORKER_URL="https://new-youtube-discovery-api.elmahdyabdulla208.workers.dev"
R2_OLD_WORKER_URL="https://old-youtube-discovery-api.elmahdyabdulla208.workers.dev"
R2_NEW_WORKER_AUTH_SECRET=""
R2_OLD_WORKER_AUTH_SECRET=""
# Optional shared fallback secret if both workers use the same HMAC secret:
WORKER_AUTH_SECRET=""

# ── 6. Official YouTube Data API v3 Settings ──────────────────────────────────
# Base endpoint for official YouTube Data API v3:
YOUTUBE_API_BASE_URL="https://www.googleapis.com/youtube/v3"

# Optional default server YouTube API key (managed keys in database take priority):
YOUTUBE_API_KEY=""

# Search behavior defaults and rate controls:
YOUTUBE_SEARCH_PAGE_SIZE="25"
YOUTUBE_SEARCH_MAX_PAGES="3"
YOUTUBE_SEARCH_MAX_ITEMS="150"
YOUTUBE_SEARCH_DELAY_MS="250"
YOUTUBE_DAILY_QUOTA_BUDGET="10000"

# Optional flag to enable durable database manifest persistence (defaults to false):
ENABLE_YOUTUBE_MANIFEST_PERSISTENCE="false"

# ── 7. Scoped Gemini AI Settings ──────────────────────────────────────────────
# Google Gemini API key for scoped manifest analysis:
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Context extraction boundaries for manifest analysis:
AI_MANIFEST_MAX_ITEMS="60"
AI_MANIFEST_MAX_CHARS="30000"

# ── 8. Managed API Key Encryption (AES-256-GCM) ───────────────────────────────
# 32-byte cryptographic key for encrypting user-managed YouTube API keys in database.
# Formats accepted: base64 (44 chars), hex (64 chars), or raw 32-character UTF-8 string.
# Independent from auth credentials. BACK THIS UP SECURELY.
API_KEYS_ENCRYPTION_KEY=""

# ── 9. Search Storage Cache TTL ───────────────────────────────────────────────
# Search storage retention period in hours for search cache (default: 168 hours / 7 days).
SEARCH_STORAGE_TTL_HOURS="168"
