# Public, browser-safe application metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase authentication and client settings.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Supabase service role / secret key for bypassing RLS, admin auth, and storage.
# NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""

# Server-only database connection for Supabase PostgreSQL (Prisma 7).
# Pooled connection string (port 6543 or 5432 via Supavisor pooler) for Prisma Client:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (port 5432 direct to database) for Prisma CLI / direct access:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Server-only YouTube Data API v3 settings. Missing YOUTUBE_API_KEY disables live provider calls.
YOUTUBE_API_BASE_URL="https://www.googleapis.com/youtube/v3"
YOUTUBE_API_KEY=""

YOUTUBE_DEFAULT_RELEVANCE_LANGUAGE="en"
YOUTUBE_SEARCH_PAGE_SIZE="25"
YOUTUBE_SEARCH_MAX_PAGES="3"
YOUTUBE_SEARCH_MAX_ITEMS="150"
YOUTUBE_SEARCH_DELAY_MS="250"
YOUTUBE_SEARCH_CONCURRENCY="1"
YOUTUBE_DAILY_QUOTA_BUDGET="10000"
ENABLE_YOUTUBE_MANIFEST_PERSISTENCE="false"

# Server-only Gemini settings. Missing GEMINI_API_KEY disables AI route execution gracefully.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_MANIFEST_MAX_ITEMS="60"
AI_MANIFEST_MAX_CHARS="30000"

# Search storage retention period in hours (legacy disk cache only).
# Blob-backed saved history is permanent and ignores this value.
# Default: 168 hours (7 days / 1 week)
SEARCH_STORAGE_TTL_HOURS="168"

# ── Cloudflare R2 via Dedicated Workers (Authoritative Object Storage) ───
# Active application data, manifests, datasets, and generations route to NEW Worker.
# Historical OLD archive manifests (asdy/old/...) route to OLD Worker.
# Zero S3 SDKs, zero AWS credentials. Access is strictly mediated via HMAC-SHA256 capability tokens.
R2_NEW_WORKER_URL="https://new-youtube-discovery-api.elmahdyabdulla208.workers.dev"
R2_OLD_WORKER_URL="https://old-youtube-discovery-api.elmahdyabdulla208.workers.dev"
# 32-byte (or 64-character hex) secrets configured via `wrangler secret put WORKER_AUTH_SECRET`:
R2_NEW_WORKER_AUTH_SECRET=""
R2_OLD_WORKER_AUTH_SECRET=""
WORKER_AUTH_SECRET=""

# ── Single administrator account (bootstrap only) ──────────────────────
# On first run the server creates exactly ONE admin account from these
# values and stores only a password hash in Blob. Afterwards the persisted
# account is authoritative: changing these vars does NOT reset credentials.
# There is no default password: ADMIN_INITIAL_PASSWORD must be set to a
# strong value (≥12 chars) before first initialization.
# Administrator account settings:
# Email of the admin account in Supabase Auth.
ADMIN_EMAIL="asdy@youtube.discov.com"
# Default username displayed on /login.
ADMIN_DEFAULT_USERNAME="asdy"
# Admin password: can be configured here via ADMIN_PASSWORD or ADMIN_INITIAL_PASSWORD.
# Used for Supabase Auth sign-in synchronization and local session authorization.
ADMIN_PASSWORD=""
ADMIN_INITIAL_PASSWORD=""
# High-entropy session secret, independent from the Blob token and the
# API key encryption key. Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=""
# Session lifetime in seconds. Default: 604800 (7 days / 1 week).
# You can control this session time via SESSION_TTL_SECONDS or ADMIN_SESSION_TTL_SECONDS.
# Accepts raw integer seconds (e.g. 604800) or human units (e.g. "7d", "1w", "24h").
SESSION_TTL_SECONDS="604800"
ADMIN_SESSION_TTL_SECONDS="604800"

# ── Managed YouTube API key encryption (AES-256-GCM) ───────────────────
# 32-byte key as base64 (44 chars), hex (64 chars), or 32 raw characters.
# Independent from Blob/session secrets. BACK THIS UP SECURELY: losing or
# changing it makes previously encrypted keys permanently unrecoverable.
# Without it, the app REFUSES to save managed keys (no plaintext fallback).
API_KEYS_ENCRYPTION_KEY=""
