# ═══════════════════════════════════════════════════════════════════════════════
# YouTube Discovery (2026) — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` (or `.env`) for local development.
# On Vercel, set these variables in Project Settings > Environment Variables.
# Validate safely without printing secrets: `npm run env:check`
#
# Rules:
# 1. Variables prefixed with `NEXT_PUBLIC_` are bundled into browser JavaScript.
# 2. Never put secrets, service role keys, database URLs, or Worker HMAC
#    secrets under `NEXT_PUBLIC_`.
# 3. Supabase Auth (`NEXT_PUBLIC_SUPABASE_URL` + Publishable + Service Role)
#    is the SOLE authority for authentication.
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. Application & Deployment Metadata (Public) ─────────────────────────────
# Base URL of the application (canonical origin for Share Target, PWA & CSRF checks).
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are auto-injected by Vercel
# as fallbacks if NEXT_PUBLIC_APP_URL is omitted.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 2. Supabase Auth & SSR Session (Required for Auth) ────────────────────────
# Browser-safe Supabase project endpoint and publishable key:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-PUBLISHABLE-KEY]"
# Optional compatibility alias accepted when PUBLISHABLE_KEY is not set:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Server-only Supabase Service Role / Secret Key (user resolution, admin CLI, backups):
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
# Optional alias used by scripts / Supabase new secret format:
SUPABASE_SECRET_KEY=""

# ── 3. Administrator Identity & Session Lifetime ──────────────────────────────
# Administrator logs in with Username mapped server-side to ADMIN_EMAIL in Supabase Auth.
ADMIN_DEFAULT_USERNAME="asdy"
ADMIN_EMAIL="asdy@youtube.discov.com"

# Session cookie / token TTL in seconds (default: 604800 = 7 days).
# Accepts seconds (e.g. "604800") or duration strings ("7d", "1w", "24h").
# Also honors fallbacks: ADMIN_SESSION_TTL_SECONDS, SUPABASE_SESSION_TTL_SECONDS, SESSION_DURATION.
SESSION_TTL_SECONDS="604800"

# Optional bootstrap/diagnostic CLI password variables (never used in production UI runtime):
# ADMIN_INITIAL_PASSWORD=""
# ADMIN_PASSWORD=""
# SUPABASE_ADMIN_PASSWORD=""

# ── 4. Supabase PostgreSQL Database (Prisma 7 / PostgreSQL 17) ────────────────
# Pooled Supavisor connection string (port 6543, pgbouncer=true) for serverless/Next.js runtime:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection (port 5432) for Prisma CLI migrations, schema checks & backups:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── 5. Cloudflare R2 via Dedicated Workers (Authoritative Object Storage) ─────
# Dedicated Cloudflare Workers mediating all Cloudflare R2 reads/writes via
# short-lived HS256 capability tokens (zero AWS S3 SDKs or raw R2 keys in Vercel).
R2_NEW_WORKER_URL="https://new-youtube-discovery-api.elmahdyabdulla208.workers.dev"
R2_OLD_WORKER_URL="https://old-youtube-discovery-api.elmahdyabdulla208.workers.dev"

# CRITICAL SECRET MATCHING:
#   - R2_NEW_WORKER_AUTH_SECRET in Next.js MUST match WORKER_AUTH_SECRET in the
#     Cloudflare Worker `new-youtube-discovery-api`.
#   - R2_OLD_WORKER_AUTH_SECRET in Next.js MUST match WORKER_AUTH_SECRET in the
#     Cloudflare Worker `old-youtube-discovery-api`.
#   - Fallback order in Next.js:
#       NEW Worker: R2_NEW_WORKER_AUTH_SECRET -> WORKER_AUTH_SECRET -> R2_WORKER_AUTH_SECRET
#       OLD Worker: R2_OLD_WORKER_AUTH_SECRET -> WORKER_AUTH_SECRET -> R2_WORKER_AUTH_SECRET
R2_NEW_WORKER_AUTH_SECRET="[REPLACE-WITH-64-HEX-OR-STRONG-RANDOM-SECRET-NEW]"
R2_OLD_WORKER_AUTH_SECRET="[REPLACE-WITH-64-HEX-OR-STRONG-RANDOM-SECRET-OLD]"
WORKER_AUTH_SECRET=""
# R2_WORKER_AUTH_SECRET=""

# ── 6. Official YouTube Data API v3 Settings ──────────────────────────────────
YOUTUBE_API_BASE_URL="https://www.googleapis.com/youtube/v3"

# Optional fallback API key (user-managed encrypted keys stored in app take precedence):
YOUTUBE_API_KEY=""

# Search defaults & quota accounting:
YOUTUBE_SEARCH_PAGE_SIZE="25"
YOUTUBE_SEARCH_MAX_PAGES="3"
YOUTUBE_SEARCH_MAX_ITEMS="150"
YOUTUBE_SEARCH_DELAY_MS="250"
YOUTUBE_DAILY_QUOTA_BUDGET="10000"

# Set "true" to enable durable database search-manifest persistence alongside R2 sync:
ENABLE_YOUTUBE_MANIFEST_PERSISTENCE="false"

# ── 7. Scoped Gemini AI Settings ──────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Context boundaries passed to Gemini when analyzing a single manifest:
AI_MANIFEST_MAX_ITEMS="60"
AI_MANIFEST_MAX_CHARS="30000"

# ── 8. Managed API Key Encryption (AES-256-GCM) ───────────────────────────────
# Required to store/rotate managed YouTube API keys safely.
# Accepted formats: 44-char Base64 (32 bytes), 64-char Hex (32 bytes), or 32-char UTF-8 string.
API_KEYS_ENCRYPTION_KEY="[REPLACE-WITH-64-HEX-CHARACTERS-AES-256-KEY]"

# ── 9. Search Cache Retention (Hours) ─────────────────────────────────────────
# Controls ephemeral client search-session cache expiry (default: 168h / 7 days).
# Never expires permanent saved items, playlists, references, or history.
SEARCH_STORAGE_TTL_HOURS="168"
NEXT_PUBLIC_SEARCH_STORAGE_TTL_HOURS="168"

# ── 10. Manifest Naming & Directory Standard (2026.1) ─────────────────────────
STORAGE_NAMING_VERSION="2026.1"
MANIFEST_TARGET_SIZE_BYTES="41943040"
MANIFEST_MAX_OBJECT_SIZE_BYTES="47185920"
MANIFEST_VERSION_PADDING="3"
MANIFEST_TIMESTAMP_TIMEZONE="UTC"
TEMP_STORAGE_TTL_SECONDS="86400"
MANIFEST_CHECKSUM_ALGORITHM="sha256"

# ── 11. CLI / Backup / Migration Utility Variables (Optional) ─────────────────
# Bucket identifiers referenced by backup & remote integration scripts:
# SUPABASE_STORAGE_BUCKET="youtube-discovery-private"
# SUPABASE_NEW_STORAGE_BUCKET="new-youtube-discovery-private"
# SUPABASE_OLD_STORAGE_BUCKET="old-youtube-discovery-private"

# CLI terminal formatting (standard NO_COLOR / TERM="dumb" disables ANSI output):
# NO_COLOR=""
# TERM=""

# Historical compatibility only (legacy pre-R2 scanner):
# BLOB_READ_WRITE_TOKEN=""
